# Nuxt reads .env during dev/build/preview. Copy this file to .env.
# Deployment: provide these variables to the running Node/Nitro server.
NUXT_PUBLIC_ENABLE_MOCKS=false
# Enable the Nuxt BFF and keep the standalone API URL server-only.
NUXT_PUBLIC_ENABLE_BFF=true
NUXT_BFF_API_BASE_URL=http://127.0.0.1:4000/v1

# Seed auth behind TLS termination: exact public HTTPS origin (no path).
# Leave empty for direct localhost development. Never trust arbitrary forwarded headers.
NUXT_AUTH_ORIGIN=
